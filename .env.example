# SQLite database file (relative to the project root / container workdir)
DATABASE_URL="file:./data/app.db"

# Required. Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Public URL the app is served from (used in links, cookies, etc.)
APP_URL="http://localhost:3000"

# Set to "true" when running behind a reverse proxy (e.g. nginx) so
# NextAuth trusts the proxied Host header. See README "Locking down
# access with nginx + mTLS" for a full reverse-proxy setup.
AUTH_TRUST_HOST=""

# Where uploaded contract documents are stored
UPLOADS_DIR="./data/uploads"

# Default reminder thresholds (days before expiry) for new contracts
REMINDER_DEFAULT_DAYS="30,14,7,1"

# Cron schedule for the built-in expiration check (node-cron syntax)
REMINDER_CRON_SCHEDULE="0 8 * * *"

# Email (SMTP) reminders — leave SMTP_HOST/SMTP_USER blank to disable
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Hearth <no-reply@localhost>"

# Push reminders via ntfy — leave NTFY_TOPIC blank to disable
NTFY_URL="https://ntfy.sh"
NTFY_TOPIC=""
NTFY_TOKEN=""

# Optional: protects POST /api/cron for triggering the expiration check
# from an external scheduler instead of (or in addition to) the built-in
# one. Leave unset to disable the endpoint entirely (it 404s).
CRON_SECRET=""

# Optional: enables GET/POST /api/mcp, a read-only Model Context Protocol
# server for querying contracts from a local LLM agent (e.g. Ollama). Leave
# unset to disable the endpoint entirely (it 404s). See README "Querying
# contracts from an LLM (MCP)".
MCP_TOKEN=""

# Optional: set both to let document auto-fill (when adding a new contract)
# fall back to your local Ollama server for field extraction when the
# built-in heuristics can't confidently parse a scanned document. Leave
# either blank to skip this fallback (heuristics-only). See README
# "Auto-filling fields from a document".
OLLAMA_BASE_URL=""
OLLAMA_MODEL=""

# Optional: route every outbound call to an AI provider (document extraction
# and the household chat assistant, cloud and Ollama both) through a local
# agent-firewall proxy instead of calling the provider directly — e.g.
# https://github.com/luckyPipewrench/pipelock, which inspects agent traffic
# for prompt injection and credential/data exfiltration attempts. Point this
# at the proxy's base URL (its "fetch" mediation endpoint is appended
# automatically). Leave unset to call providers directly, as before. See
# README "Routing AI traffic through an agent firewall".
AI_EGRESS_PROXY_URL=""

# Optional: set an IMAP mailbox to let household members email or forward a
# document (invoice, receipt, warranty, etc.) to it. Hearth polls it on a
# schedule, guesses what type of document each attachment is, and drops it in
# the Documents inbox for review — nothing is ever filed without a human
# confirming it first. Leave EMAIL_INGEST_HOST unset to disable entirely.
EMAIL_INGEST_HOST=""
EMAIL_INGEST_PORT="993"
EMAIL_INGEST_SECURE="true"
EMAIL_INGEST_USER=""
EMAIL_INGEST_PASSWORD=""
EMAIL_INGEST_MAILBOX="INBOX"
EMAIL_INGEST_CRON_SCHEDULE="*/10 * * * *"

# Optional: set to "true" to let scanning a product's barcode (in the
# "Add product" form) look up its name/brand from UPCitemdb so you don't
# have to type them in. Leave unset/false to disable — the barcode itself
# is still captured and saved, just without the online lookup. Uses the
# free, keyless trial endpoint (rate-limited per IP) unless
# BARCODE_LOOKUP_API_KEY is set. See README "Barcode scanning for
# products".
BARCODE_LOOKUP_ENABLED=""
BARCODE_LOOKUP_API_KEY=""

# Required to enable "bring your own key" AI document extraction (Settings
# page), and also required (see below) to enable offsite database backups.
# Encrypts each user's API key at rest, and every backup before upload, with
# AES-256-GCM. Generate with: openssl rand -base64 32
# Leave blank to disable both features (the AI Settings section is hidden,
# extraction falls back to local heuristics/Ollama, and backups stay
# disabled). See README "Bring your own AI key".
ENCRYPTION_KEY=""

# Optional gate on first-run setup. Until the first account exists, /setup is
# reachable by anyone who can reach the server, and whoever submits it first
# becomes the administrator. Set this to a random string and you'll be asked
# for it on the setup screen, so a server that's exposed before you've
# registered can't be claimed by someone else. Generate with:
# openssl rand -hex 16
# Has no effect once setup is complete — /setup redirects to /login from then
# on — so it's safe to leave set, or to remove afterwards.
SETUP_TOKEN=""

# Refuse outbound requests (webhooks, ntfy, Ollama) to addresses on your own
# network. OFF by default and normally should stay off: bare IP addresses and
# local hostnames are fully supported destinations — http://192.168.1.50:8123,
# https://homeassistant.local:8123, http://ntfy:80, http://localhost:11434 all
# work. Only turn this on if none of your integrations point at your own
# network and you want that enforced.
# Cloud instance-metadata addresses (169.254.169.254 and friends) are always
# refused regardless of this setting.
BLOCK_PRIVATE_NETWORK_TARGETS=""

# Offsite database backups — requires ENCRYPTION_KEY above (backups are
# always encrypted before upload, never sent in the clear). Only one
# destination is active at a time, chosen in System settings (Settings >
# System > Backup destination) — env vars below just pre-populate that
# destination's fields, they don't select it. See README "Database backups".
BACKUP_CRON_SCHEDULE="0 3 * * *"
BACKUP_RETENTION_COUNT="7"

# S3-compatible storage (AWS S3, Backblaze B2, Cloudflare R2, MinIO, etc.)
BACKUP_S3_ENDPOINT=""
BACKUP_S3_REGION="auto"
BACKUP_S3_BUCKET=""
BACKUP_S3_ACCESS_KEY_ID=""
BACKUP_S3_SECRET_ACCESS_KEY=""
BACKUP_S3_FORCE_PATH_STYLE="false"

# SFTP. Use either BACKUP_SFTP_PASSWORD or BACKUP_SFTP_PRIVATE_KEY (a
# PEM-format private key), not necessarily both.
BACKUP_SFTP_HOST=""
BACKUP_SFTP_PORT="22"
BACKUP_SFTP_USERNAME=""
BACKUP_SFTP_PASSWORD=""
BACKUP_SFTP_PRIVATE_KEY=""
BACKUP_SFTP_REMOTE_PATH="/backups"

# Local filesystem. Point this at a path inside your existing data volume
# (e.g. ./data/backups) so backups are covered by whatever you already back
# up, without a separate volume.
BACKUP_LOCAL_PATH=""

# Optional: enables "Sign in with GitHub" on the login page. Sign-up stays
# invite-only — a GitHub sign-in only succeeds for an email that already has
# an admin-invited Hearth account (Settings > Users). Leave blank to disable.
# Register an OAuth app at https://github.com/settings/developers with
# callback URL "<APP_URL>/api/auth/callback/github".
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
