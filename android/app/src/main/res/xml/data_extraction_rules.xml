<?xml version="1.0" encoding="utf-8"?>
<!--
  The shell's local storage holds the self-hosted server address, the WebView
  session cookie and any client certificate the user imported. None of that
  should leave the device via cloud backup or device-to-device transfer, so
  both paths are disabled outright (Android 12+; android:allowBackup="false"
  covers older releases).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
