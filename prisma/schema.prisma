generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum Role {
  ADMIN
  MEMBER
  READONLY
}

enum ContractCategory {
  RENTAL
  CAR_INSURANCE
  HOME_INSURANCE
  STRATA_INSURANCE
  HEALTH_INSURANCE
  LIFE_INSURANCE
  UTILITY
  TELECOM
  SUBSCRIPTION
  LOAN
  WARRANTY
  OTHER
}

enum RenewalType {
  AUTO_RENEW
  MANUAL_RENEWAL
  FIXED_TERM
}

enum BillingFrequency {
  WEEKLY
  MONTHLY
  QUARTERLY
  ANNUALLY
  ONE_OFF
}

enum ContractStatus {
  ACTIVE
  CANCELLED
}

enum NotificationChannel {
  EMAIL
  NTFY
  WEBHOOK
}

// #201 foundation: NotificationLog is now polymorphic across the three
// reminder-eligible record types (previously three separate tables —
// NotificationLog/ProductNotificationLog/VehicleNotificationLog — that
// scheduler.ts had to handle three times over).
enum NotificationOwnerType {
  CONTRACT
  PRODUCT
  VEHICLE
}

enum NotificationStatus {
  SENT
  FAILED
}

enum SecurityEventType {
  LOGIN_FAILED
  LOGIN_THROTTLED
  PASSWORD_CHANGED
  PASSWORD_RESET_COMPLETED
  TOTP_DISABLED
  ROLE_CHANGED
  USER_DELETED
}

enum ProductDocumentKind {
  INVOICE
  PHOTO
  MANUAL
  OTHER
}

enum AiProvider {
  ANTHROPIC
  GEMINI
  OPENAI
  OLLAMA
  OPENROUTER
}

enum BackupDestination {
  S3
  SFTP
  LOCAL
}

enum BackupStatus {
  SUCCESS
  FAILURE
}

enum ModuleKey {
  TRAVEL
  HOME
  VEHICLES
  INVENTORY
  WEALTH
}

enum ChatRole {
  USER
  ASSISTANT
  TOOL
}

enum AssetClass {
  SHARE
  ETF
  MANAGED_FUND
  CRYPTO
  CASH
  OTHER
}

enum TradeType {
  BUY
  SELL
  DIVIDEND
  SPLIT
}

enum InventoryItemCategory {
  APPLIANCE
  ELECTRONICS
  FURNITURE
  TOOL
  CLOTHING
  SPORTING
  BOOK
  MEDIA
  OTHER
}

enum VehicleItemType {
  SERVICE
  REPAIR
  ROADWORTHY
  MODIFICATION
  OTHER
}

enum TripSegmentType {
  FLIGHT
  LODGING
  ACTIVITY
}

enum HomeItemType {
  MAINTENANCE
  IMPROVEMENT
  REPAIR
  OTHER
}

enum OccupancyStatus {
  OWNER_OCCUPIED
  RENTED
  VACANT
  OTHER
}

model User {
  id                String     @id @default(cuid())
  name              String
  email             String     @unique
  passwordHash      String
  role              Role       @default(MEMBER)
  emailReminders    Boolean    @default(true)
  // Bumped whenever a session must stop being trusted — password change,
  // role change. Every JWT carries the value it was minted with; a mismatch
  // invalidates the token (see the jwt callback in src/lib/auth.ts).
  sessionVersion    Int        @default(0)
  // SHA-256 of the iCal feed token, never the token itself. Kept on the
  // original column name so no data migration is needed for the rename.
  icalTokenHash     String?    @unique @map("icalToken")
  dateFormat        String     @default("DD/MM/YYYY")
  preferredCurrency String     @default("AUD")
  timezone          String     @default("UTC")
  region            String     @default("en-AU")
  createdAt         DateTime   @default(now())
  contracts         Contract[]
  products          Product[]
  webhookEndpoints  WebhookEndpoint[]
  trips             Trip[]
  properties        Property[]
  passkeys          PasskeyCredential[]
  vehicles          Vehicle[]
  inventoryItems    InventoryItem[]
  portfolios        Portfolio[]
  inboxDocuments    InboxDocument[]
  chatThreads       ChatThread[]
  passwordResetTokens PasswordResetToken[]
  totpSecret          String?
  totpEnabled         Boolean   @default(false)
  totpRecoveryCodes   String?

  @@map("users")
}

enum PasswordResetTokenPurpose {
  RESET
  INVITE
}

model PasswordResetToken {
  id        String                    @id @default(cuid())
  // SHA-256 of the emailed token. A leaked database snapshot shouldn't hand
  // over working password-reset and invitation links.
  tokenHash String                    @unique @map("token")
  userId    String
  user      User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose   PasswordResetTokenPurpose @default(RESET)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime                  @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

model PasskeyCredential {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialId String    @unique
  publicKey    Bytes
  counter      Int       @default(0)
  transports   String?
  nickname     String?
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?

  @@index([userId])
  @@map("passkey_credentials")
}

model PasskeyChallenge {
  id        String   @id @default(cuid())
  userId    String?
  challenge String   @unique
  type      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("passkey_challenges")
}

model Contract {
  id                String        @id @default(cuid())
  title             String
  category          ContractCategory
  provider          String
  contractNumber    String?
  startDate         DateTime?
  endDate           DateTime?
  renewalType       RenewalType   @default(MANUAL_RENEWAL)
  noticePeriodDays  Int?
  cost              Float?
  currency          String        @default("AUD")
  billingFrequency  BillingFrequency?
  status            ContractStatus @default(ACTIVE)
  contactName       String?
  contactPhone      String?
  contactEmail      String?
  notes             String?
  reminderDaysBefore String?      @default("30,14,7,1")
  isTaxDeductible   Boolean       @default(false)
  // #200: true when a document scan populated critical fields this session
  // and the user saved without checking "confirm these are correct" — the
  // scheduler (see notifications/scheduler.ts) skips reminders for this
  // contract until it's cleared, either by re-confirming on the form or via
  // the detail page's standalone "Confirm details" action.
  extractionPending Boolean       @default(false)
  extractionConfirmedAt DateTime?

  createdById       String
  createdBy         User          @relation(fields: [createdById], references: [id])

  propertyId        String?
  property          Property?     @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  vehicleId         String?
  vehicle           Vehicle?      @relation(fields: [vehicleId], references: [id], onDelete: SetNull)

  documents         Document[]
  rentalAgreement   RentalAgreement?

  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@map("contracts")
}

model Document {
  id            String    @id @default(cuid())
  contractId    String
  contract      Contract  @relation(fields: [contractId], references: [id], onDelete: Cascade)
  filename      String
  storedName    String
  mimeType      String
  size          Int
  extractedText String?
  extractionStatus String @default("PENDING")
  // File-hash and version-chain fields (#206/#207/#208 foundation) — sha256
  // enables exact-duplicate detection, supersedesId links a re-upload to the
  // document it replaces (linear chain, enforced @unique so a document has
  // at most one successor), isImportant is the user-starred flag.
  sha256        String?
  isImportant   Boolean   @default(false)
  supersedesId  String?   @unique
  supersedes    Document? @relation("DocumentVersions", fields: [supersedesId], references: [id], onDelete: SetNull)
  supersededBy  Document? @relation("DocumentVersions")
  uploadedAt    DateTime  @default(now())

  @@index([sha256])
  @@map("documents")
}

// Holds a document saved before its destination (Contract, Product, ...) is
// known — the "Not sure yet" import path. Classifying one creates the real
// row in the matching per-entity document table and deletes this one; it is
// never a permanent home for a file, only a queue.
model InboxDocument {
  id            String        @id @default(cuid())
  filename      String
  storedName    String
  mimeType      String
  size          Int
  extractedText String?
  extractionStatus String @default("PENDING")
  sha256        String?

  // Null for email-ingested documents (#195), which have no acting web user.
  uploadedById  String?
  uploadedBy    User?         @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  source        InboxSource   @default(WEB)
  // Sender address for EMAIL-sourced documents, kept for provenance/review —
  // never used for authorization or auto-filing.
  fromAddress   String?
  // Best-guess target type from cheap heuristic-only scoring at ingestion
  // time (#195) — pre-selects the classify dropdown, never auto-files.
  guessedType   InboxTargetType?
  // #199/#206: computed once at ingestion (see computeInboxIntake) from
  // extraction success, guessedType, and a sha256 match against every filed
  // document table — never recomputed afterward, so a status set here stays
  // stable even if e.g. the matched duplicate is later deleted.
  status        InboxDocumentStatus @default(NEEDS_CLASSIFICATION)

  uploadedAt    DateTime      @default(now())

  @@index([sha256])
  @@map("inbox_documents")
}

enum InboxSource {
  WEB
  EMAIL
}

enum InboxTargetType {
  CONTRACT
  PRODUCT
  INVENTORY
}

enum InboxDocumentStatus {
  NEEDS_CLASSIFICATION
  NEEDS_REVIEW
  EXTRACTION_FAILED
  POSSIBLE_DUPLICATE
}

// Records inbound email Message-IDs already ingested (#195), so a poll that
// re-observes a message already \Seen by a different mail client (or before
// this cycle's IMAP flag update lands) never creates a duplicate inbox entry.
model ProcessedEmailMessage {
  id          String   @id @default(cuid())
  messageId   String   @unique
  processedAt DateTime @default(now())

  @@map("processed_email_messages")
}

model NotificationLog {
  id            String                @id @default(cuid())
  ownerType     NotificationOwnerType
  ownerId       String
  // Vehicle only — distinguishes rego vs insurance reminders on the same
  // vehicle. Empty string (never null) for contract/product so the unique
  // index below fully enforces uniqueness — SQLite treats each NULL in a
  // unique index as distinct, which would silently defeat it here.
  field         String                @default("")
  channel       NotificationChannel
  thresholdDays Int
  status        NotificationStatus    @default(SENT)
  error         String?
  sentAt        DateTime              @default(now())

  @@unique([ownerType, ownerId, field, channel, thresholdDays])
  @@index([ownerType, ownerId])
  @@map("notification_logs")
}

model Product {
  id                 String    @id @default(cuid())
  description        String
  manufacturer       String?
  model              String?
  vendor             String?
  serialNumber       String?
  barcode            String?
  purchaseDate       DateTime?
  warrantyEndDate    DateTime?
  price              Float?
  currency           String    @default("AUD")
  notes              String?
  reminderDaysBefore String?   @default("30,14,7,1")
  // See the equivalent Contract fields for the full explanation (#200).
  extractionPending  Boolean   @default(false)
  extractionConfirmedAt DateTime?

  createdById        String
  createdBy          User      @relation(fields: [createdById], references: [id])

  propertyId         String?
  property           Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  documents          ProductDocument[]

  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@map("products")
}

model ProductDocument {
  id            String               @id @default(cuid())
  productId     String
  product       Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  filename      String
  storedName    String
  mimeType      String
  size          Int
  kind          ProductDocumentKind  @default(OTHER)
  extractedText String?
  extractionStatus String @default("PENDING")
  sha256        String?
  isImportant   Boolean              @default(false)
  supersedesId  String?              @unique
  supersedes    ProductDocument?     @relation("ProductDocumentVersions", fields: [supersedesId], references: [id], onDelete: SetNull)
  supersededBy  ProductDocument?     @relation("ProductDocumentVersions")
  uploadedAt    DateTime             @default(now())

  @@index([sha256])
  @@map("product_documents")
}

model AppSetting {
  key       String   @id
  value     String?
  encrypted Boolean  @default(false)
  updatedAt DateTime @updatedAt

  @@map("app_settings")
}

model BackupLog {
  id          String            @id @default(cuid())
  destination BackupDestination
  status      BackupStatus
  fileName    String?
  sizeBytes   Int?
  message     String?
  startedAt   DateTime          @default(now())
  finishedAt  DateTime?

  @@map("backup_logs")
}

model WebhookEndpoint {
  id          String       @id @default(cuid())
  name        String
  url         String
  // Encrypted with ENCRYPTION_KEY when one is configured. secretEncrypted
  // records which form this row is in, so instances that predate the key
  // keep working and get upgraded on next write (same pattern as AppSetting).
  secret          String?
  secretEncrypted Boolean  @default(false)
  enabled     Boolean      @default(true)

  createdById String
  createdBy   User         @relation(fields: [createdById], references: [id])

  logs        WebhookLog[]

  createdAt   DateTime     @default(now())

  @@map("webhook_endpoints")
}

model WebhookLog {
  id         String          @id @default(cuid())
  endpointId String
  endpoint   WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  event      String
  success    Boolean
  statusCode Int?
  message    String?
  sentAt     DateTime        @default(now())

  @@map("webhook_logs")
}

// Deliberately not a relation to User: an audit trail needs to survive the
// deletion of the account it's about (including the USER_DELETED event for
// that same deletion), same reasoning as createdById elsewhere in this
// schema (see CLAUDE.md) — it's a record of what happened, not a live link.
model SecurityEventLog {
  id        String            @id @default(cuid())
  type      SecurityEventType
  userId    String?
  email     String?
  detail    String?
  address   String?
  createdAt DateTime          @default(now())

  @@index([createdAt])
  @@map("security_event_logs")
}

model ModuleEnablement {
  id        String    @id @default(cuid())
  key       ModuleKey @unique
  enabled   Boolean   @default(false)
  updatedAt DateTime  @updatedAt

  @@map("module_enablements")
}

model Trip {
  id          String        @id @default(cuid())
  title       String
  destination String?
  startDate   DateTime?
  endDate     DateTime?
  notes       String?

  createdById String
  createdBy   User          @relation(fields: [createdById], references: [id])

  segments    TripSegment[]

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@map("trips")
}

model TripSegment {
  id               String                @id @default(cuid())
  tripId           String
  trip             Trip                  @relation(fields: [tripId], references: [id], onDelete: Cascade)
  type             TripSegmentType
  title            String
  provider         String?
  confirmationCode String?
  startDate        DateTime?
  endDate          DateTime?
  location         String?
  cost             Float?
  currency         String                @default("AUD")
  notes            String?

  // Flight-specific fields (populated from AviationStack when type=FLIGHT)
  flightNumber     String?
  departureIata    String?
  arrivalIata      String?
  flightStatus     String?
  scheduledDep     DateTime?
  scheduledArr     DateTime?
  estimatedDep     DateTime?
  estimatedArr     DateTime?
  actualDep        DateTime?
  actualArr        DateTime?
  depTerminal      String?
  depGate          String?
  arrTerminal      String?
  arrGate          String?
  flightStatusAt   DateTime?

  documents        TripSegmentDocument[]

  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  @@map("trip_segments")
}

model TripSegmentDocument {
  id            String               @id @default(cuid())
  tripSegmentId String
  tripSegment   TripSegment          @relation(fields: [tripSegmentId], references: [id], onDelete: Cascade)
  filename      String
  storedName    String
  mimeType      String
  size          Int
  sha256        String?
  isImportant   Boolean              @default(false)
  supersedesId  String?              @unique
  supersedes    TripSegmentDocument? @relation("TripSegmentDocumentVersions", fields: [supersedesId], references: [id], onDelete: SetNull)
  supersededBy  TripSegmentDocument? @relation("TripSegmentDocumentVersions")
  uploadedAt    DateTime             @default(now())

  @@index([sha256])
  @@map("trip_segment_documents")
}

model Property {
  id              String          @id @default(cuid())
  label           String
  street          String?
  suburb          String?
  state           String?
  postcode        String?
  country         String?
  lat             Float?
  lng             Float?
  notes           String?
  isRented        Boolean         @default(false)
  occupancyStatus OccupancyStatus @default(OWNER_OCCUPIED)

  createdById String
  createdBy   User    @relation(fields: [createdById], references: [id])

  items             HomeItem[]
  rentalAgreements  RentalAgreement[]
  rentalStatements  RentalStatement[]
  valuations        PropertyValuation[]
  contracts         Contract[]
  products          Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("properties")
}

model RentalAgreement {
  id                   String    @id @default(cuid())
  propertyId           String
  property             Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  contractId           String?   @unique
  contract             Contract? @relation(fields: [contractId], references: [id], onDelete: SetNull)
  tenantName           String?
  weeklyRent           Float
  managementFeePercent Float?
  leaseStart           DateTime?
  leaseEnd             DateTime?
  bondAmount           Float?
  currency             String    @default("AUD")
  notes                String?
  createdAt            DateTime  @default(now())

  @@map("rental_agreements")
}

model RentalStatement {
  id              String                    @id @default(cuid())
  propertyId      String
  property        Property                  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  periodStart     DateTime?
  periodEnd       DateTime?
  statementDate   DateTime?
  grossRent       Float?
  managementFee   Float?
  otherDeductions Float?
  netAmount       Float?
  currency        String                    @default("AUD")
  notes           String?
  documents       RentalStatementDocument[]
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  @@map("rental_statements")
}

model RentalStatementDocument {
  id                String                   @id @default(cuid())
  rentalStatementId String
  rentalStatement   RentalStatement          @relation(fields: [rentalStatementId], references: [id], onDelete: Cascade)
  filename          String
  storedName        String
  mimeType          String
  size              Int
  sha256            String?
  isImportant       Boolean                  @default(false)
  supersedesId      String?                  @unique
  supersedes        RentalStatementDocument? @relation("RentalStatementDocumentVersions", fields: [supersedesId], references: [id], onDelete: SetNull)
  supersededBy      RentalStatementDocument? @relation("RentalStatementDocumentVersions")
  uploadedAt        DateTime                 @default(now())

  @@index([sha256])
  @@map("rental_statement_documents")
}

model HomeItem {
  id         String             @id @default(cuid())
  propertyId String
  property   Property           @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  type       HomeItemType
  title      String
  provider   String?
  date       DateTime?
  cost       Float?
  currency   String             @default("AUD")
  isTaxDeductible Boolean       @default(false)
  notes      String?

  documents  HomeItemDocument[]

  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  @@map("home_items")
}

model HomeItemDocument {
  id           String            @id @default(cuid())
  homeItemId   String
  homeItem     HomeItem          @relation(fields: [homeItemId], references: [id], onDelete: Cascade)
  filename     String
  storedName   String
  mimeType     String
  size         Int
  sha256       String?
  isImportant  Boolean           @default(false)
  supersedesId String?           @unique
  supersedes   HomeItemDocument? @relation("HomeItemDocumentVersions", fields: [supersedesId], references: [id], onDelete: SetNull)
  supersededBy HomeItemDocument? @relation("HomeItemDocumentVersions")
  uploadedAt   DateTime          @default(now())

  @@index([sha256])
  @@map("home_item_documents")
}

model Vehicle {
  id                 String    @id @default(cuid())
  label              String
  make               String?
  model              String?
  year               Int?
  colour             String?
  licensePlate       String?
  vin                String?
  regoExpiry         DateTime?
  insuranceExpiry    DateTime?
  reminderDaysBefore String?   @default("30,14,7,1")
  notes              String?

  createdById        String
  createdBy          User      @relation(fields: [createdById], references: [id])

  items              VehicleItem[]
  contracts          Contract[]

  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@map("vehicles")
}

model VehicleItem {
  id          String          @id @default(cuid())
  vehicleId   String
  vehicle     Vehicle         @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  type        VehicleItemType
  title       String
  provider    String?
  date        DateTime?
  cost        Float?
  currency    String          @default("AUD")
  notes       String?

  documents   VehicleItemDocument[]

  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@map("vehicle_items")
}

model VehicleItemDocument {
  id            String               @id @default(cuid())
  vehicleItemId String
  vehicleItem   VehicleItem          @relation(fields: [vehicleItemId], references: [id], onDelete: Cascade)
  filename      String
  storedName    String
  mimeType      String
  size          Int
  sha256        String?
  isImportant   Boolean              @default(false)
  supersedesId  String?              @unique
  supersedes    VehicleItemDocument? @relation("VehicleItemDocumentVersions", fields: [supersedesId], references: [id], onDelete: SetNull)
  supersededBy  VehicleItemDocument? @relation("VehicleItemDocumentVersions")
  uploadedAt    DateTime             @default(now())

  @@index([sha256])
  @@map("vehicle_item_documents")
}

model InventoryItem {
  id            String                @id @default(cuid())
  label         String
  category      InventoryItemCategory @default(OTHER)
  brand         String?
  model         String?
  serialNumber  String?
  purchaseDate  DateTime?
  purchasePrice Float?
  currency      String                @default("AUD")
  location      String?
  notes         String?

  documents     InventoryItemDocument[]

  createdById   String
  createdBy     User                  @relation(fields: [createdById], references: [id])

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("inventory_items")
}

model InventoryItemDocument {
  id              String                 @id @default(cuid())
  inventoryItemId String
  inventoryItem   InventoryItem          @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  filename        String
  storedName      String
  mimeType        String
  size            Int
  sha256          String?
  isImportant     Boolean                @default(false)
  supersedesId    String?                @unique
  supersedes      InventoryItemDocument? @relation("InventoryItemDocumentVersions", fields: [supersedesId], references: [id], onDelete: SetNull)
  supersededBy    InventoryItemDocument? @relation("InventoryItemDocumentVersions")
  uploadedAt      DateTime               @default(now())

  @@index([sha256])
  @@map("inventory_item_documents")
}

model Portfolio {
  id          String    @id @default(cuid())
  name        String
  description String?
  currency    String    @default("AUD")
  createdById String
  createdBy   User      @relation(fields: [createdById], references: [id])
  holdings    Holding[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("portfolios")
}

model Holding {
  id          String     @id @default(cuid())
  portfolioId String
  portfolio   Portfolio  @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  ticker      String
  name        String?
  assetClass  AssetClass @default(SHARE)
  exchange    String?
  trades      Trade[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([portfolioId, ticker])
  @@map("holdings")
}

model Trade {
  id                 String          @id @default(cuid())
  holdingId          String
  holding            Holding         @relation(fields: [holdingId], references: [id], onDelete: Cascade)
  type               TradeType
  date               DateTime
  units              Float
  pricePerUnit       Float
  marketPriceOnDate  Float?
  fees               Float?
  currency           String          @default("AUD")
  fxRate             Float?
  notes              String?
  documents          TradeDocument[]
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@map("trades")
}

model TradeDocument {
  id           String         @id @default(cuid())
  tradeId      String
  trade        Trade          @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  filename     String
  storedName   String
  mimeType     String
  size         Int
  sha256       String?
  isImportant  Boolean        @default(false)
  supersedesId String?        @unique
  supersedes   TradeDocument? @relation("TradeDocumentVersions", fields: [supersedesId], references: [id], onDelete: SetNull)
  supersededBy TradeDocument? @relation("TradeDocumentVersions")
  uploadedAt   DateTime       @default(now())

  @@index([sha256])
  @@map("trade_documents")
}

model PriceCache {
  ticker    String   @id
  price     Float
  currency  String   @default("AUD")
  changePct Float?
  source    String
  cachedAt  DateTime

  @@map("price_cache")
}

// Cached from/to currency-pair conversion rates (e.g. "USD_AUD" -> how many
// AUD per 1 USD), used to correctly aggregate amounts recorded in different
// currencies (spend totals, net worth) rather than summing raw numbers.
model FxRate {
  pair     String   @id
  rate     Float
  cachedAt DateTime

  @@map("fx_rates")
}

model PriceHistory {
  id       String   @id @default(cuid())
  ticker   String
  date     DateTime
  close    Float
  adjClose Float?
  source   String

  @@unique([ticker, date])
  @@map("price_history")
}

model BackgroundJob {
  id          String   @id @default(cuid())
  type        String
  payload     String
  status      String   @default("PENDING")
  attempts    Int      @default(0)
  availableAt DateTime @default(now())
  leasedUntil DateTime?
  startedAt   DateTime?
  finishedAt  DateTime?
  lastError   String?
  createdAt   DateTime @default(now())

  @@index([status, availableAt])
  @@map("background_jobs")
}

model PropertyValuation {
  id         String   @id @default(cuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  valuedAt   DateTime
  value      Float
  currency   String   @default("AUD")
  source     String?
  notes      String?
  createdAt  DateTime @default(now())

  @@map("property_valuations")
}

// A conversation is private to the household member who started it, but the
// underlying data the assistant can query stays household-wide (see
// src/lib/chat/tools.ts) — consistent with every other domain model here.
model ChatThread {
  id          String        @id @default(cuid())
  title       String?
  createdById String
  createdBy   User          @relation(fields: [createdById], references: [id], onDelete: Cascade)
  messages    ChatMessage[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([createdById])
  @@map("chat_threads")
}

model ChatMessage {
  id         String     @id @default(cuid())
  threadId   String
  thread     ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  role       ChatRole
  content    String
  // ASSISTANT rows that requested tool calls store the request(s) here as
  // JSON ({id, name, input}[]); TOOL-role rows use toolCallId/toolName to
  // link a result back to the request it answers, and content holds the
  // JSON-serialized tool result. Kept as plain strings (not a relation)
  // since this is provider-facing replay data, never queried on its own.
  toolCalls  String?
  toolCallId String?
  toolName   String?
  createdAt  DateTime   @default(now())

  @@index([threadId])
  @@map("chat_messages")
}
