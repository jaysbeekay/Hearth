      "expected": [{ "field": "warrantyEndDate", "date": "2026-11-13", "daysLeft": 20, "state": "later", "label": "Ends 13 Nov" }]
    },
    {
      "name": "thresholds: zero still makes the day itself due soon",
      "record": { "kind": "warranty", "warrantyEndDate": "2026-10-24", "reminderDaysBefore": "0" },
      "expected": [{ "field": "warrantyEndDate", "date": "2026-10-24", "daysLeft": 0, "state": "due-soon", "label": "Ends today" }]
    },
    {
      "name": "thresholds: negative values are unusable, so the household default applies",
