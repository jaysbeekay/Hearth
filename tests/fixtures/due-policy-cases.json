      "expected": [{ "field": "warrantyEndDate", "date": "2026-11-13", "daysLeft": 20, "state": "later", "label": "Ends 13 Nov" }]
    },
    {
      "name": "thresholds: only fractional values means the household default applies",
      "record": { "kind": "warranty", "warrantyEndDate": "2026-11-13", "reminderDaysBefore": "1.5" },
      "expected": [{ "field": "warrantyEndDate", "date": "2026-11-13", "daysLeft": 20, "state": "due-soon", "label": "Ends 13 Nov" }]
    },
    {
      "name": "thresholds: an unusable household default leaves a window of zero",
      "defaultReminderDays": "abc",
      "record": { "kind": "warranty", "warrantyEndDate": "2026-11-13", "reminderDaysBefore": null },
      "expected": [{ "field": "warrantyEndDate", "date": "2026-11-13", "daysLeft": 20, "state": "later", "label": "Ends 13 Nov" }]
    },
    {
      "name": "timezone: already tomorrow in Sydney, so yesterday's end date has Lapsed",
      "now": "2026-10-24T14:30:00.000Z",
      "timezone": "Australia/Sydney",
      "record": { "kind": "warranty", "warrantyEndDate": "2026-10-24", "reminderDaysBefore": null },
      "expected": [{ "field": "warrantyEndDate", "date": "2026-10-24", "daysLeft": -1, "state": "lapsed", "label": "Lapsed 24 Oct" }]
    },
    {
      "name": "timezone: the same moment in UTC is still the end date",
      "now": "2026-10-24T14:30:00.000Z",
      "timezone": "UTC",
      "record": { "kind": "warranty", "warrantyEndDate": "2026-10-24", "reminderDaysBefore": null },
      "expected": [{ "field": "warrantyEndDate", "date": "2026-10-24", "daysLeft": 0, "state": "due-soon", "label": "Ends today" }]
    },
